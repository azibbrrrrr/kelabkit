# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Neon pooled connection (application runtime).
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/kelabkit?sslmode=require
# Neon direct connection (migrations, seed, db:test).
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/kelabkit?sslmode=require
# Neon Auth base URL (used from the auth PR onwards).
NEON_AUTH_BASE_URL=https://ep-EXAMPLE.neonauth.REGION.aws.neon.tech/kelabkit/auth
# Which database this is. db:seed refuses to run unless this is "dev".
KELABKIT_DB_ENV=dev
